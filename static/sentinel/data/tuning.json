{
  "player": {
    "walkSpeed": 60,
    "radius": 6
  },
  "props": {
    "$comment": "sway: top-of-sprite lean in px at full wind (0 or absent = rigid); swayPush: tall grass leaning away from a passing player; light: a light the renderer adds at the prop (src/engine/Lighting.js: radius px, intensity 0..1, color, flicker 0..1, pulse { speed rad/s, depth 0..1 }, glow 0..1 additive colour, zoneBoost x anomaly strength)",
    "palm": { "radius": 6, "sway": 4 },
    "rock": { "radius": 9 },
    "tall_grass": { "radius": 0, "coverRadius": 12, "sway": 3, "swayPush": { "radius": 16, "amount": 3, "$comment": "extra lean px away from a player within radius px" } },
    "monolith": { "radius": 10, "light": { "radius": 64, "intensity": 0.75, "color": "#8b5cf6", "$color": "violet", "pulse": { "speed": 1.4, "depth": 0.45 }, "glow": 0.8, "zoneBoost": 0.5 } },
    "banyan": { "radius": 12, "sway": 2 },
    "mangrove": { "radius": 7, "coverRadius": 14, "sway": 2, "light": { "radius": 20, "intensity": 0.3, "color": "#6ff3ff", "$color": "cyan, bioluminescent roots", "flicker": 0.35, "glow": 0.4 } },
    "campfire": { "radius": 6, "light": { "radius": 96, "intensity": 0.95, "color": "#f2a33a", "$color": "amber", "flicker": 0.18, "glow": 0.2 } },
    "totem": { "radius": 5 },
    "wreck_hull": { "radius": 0 },
    "kayak": { "radius": 8 },
    "tent": { "radius": 12 },
    "dinghy": { "radius": 10 },
    "radio_rock": { "radius": 14 },
    "coconut_palm": { "radius": 6 },
    "spring": { "radius": 0 },
    "driftwood_pile": { "radius": 0 },
    "cliff_rock": { "radius": 14 },
    "glow_fungus": { "radius": 0 },
    "shack": { "radius": 0 },
    "skeleton": { "radius": 0 },
    "life_vest": { "radius": 0 },
    "wreck_hatch": { "radius": 0 },
    "campfire_cold": { "radius": 0 },
    "sat_phone": { "radius": 0 },
    "map_board": { "radius": 4 },
    "warning_arrows": { "radius": 0 },
    "crate": { "radius": 9 }
  },
  "tide": {
    "floodThresholds": [0.9, 0.8, 0.7, 0.6, 0.5, 0.4, 0.3, 0.2, 0.1]
  },
  "world": {
    "$comment": "WorldState (src/world/WorldState.js): tide clock, day/night and weather. Seconds are real seconds.",
    "tide": {
      "periodSeconds": 360,
      "startPhase": 0.7,
      "$startPhase": "0 = low water, 0.5 = high water. 0.7 = falling past mid-tide (height 0.65): the reef tip starts to emerge within the first minute and low water comes 108 s into a new game",
      "lowBelow": 0.15,
      "highAbove": 0.85,
      "debugFastPeriodSeconds": 30
    },
    "day": {
      "lengthSeconds": 780,
      "$lengthSeconds": "13 minutes = 2.17 tide cycles: low water comes about 1.8 in-game hours later each day, so it drifts through day and night over successive days (720 s would pin it to the same hours); 25-40 minute runs last 2-3 days",
      "startHour": 6,
      "dawnStart": 5,
      "dawnEnd": 7,
      "duskStart": 18,
      "duskEnd": 20,
      "moonCycleDays": 8,
      "moonStartPhase": 0.3,
      "moonlightMin": 0.05,
      "moonlightMax": 0.35
    },
    "visibility": {
      "$comment": "src/world/visibility.js ambientVisibility: sight-range factor; night = moonless clear night, moonGain per unit of world.moonlight",
      "night": 0.45,
      "moonGain": 0.6
    },
    "weather": {
      "firstSquallSeconds": 270,
      "$firstSquallSeconds": "fixed, so a new game's sky never depends on the seed; the first squall arrives after the first low water",
      "clearSeconds": [180, 420],
      "squallSeconds": [60, 120],
      "$squallSeconds": "about one squall every 6-7 minutes (two per in-game day), raining a quarter of the time",
      "rampInSeconds": 20,
      "rampOutSeconds": 20,
      "squall": { "noiseMultiplier": 0.5, "visibilityMultiplier": 0.7, "moveMultiplier": 0.9 },
      "wind": { "calm": 0.2, "squall": 0.75, "gustAmplitude": 0.15, "gustRate": 0.25, "gustSeconds": [2, 6] }
    }
  },
  "lighting": {
    "$comment": "src/engine/Lighting.js (presentation). ambient: keyframes by hour, linearly interpolated (colour and darkness = alpha of the tint layer); colours from assets/src/palette.gpl. moonLift: darkness removed per unit of world.moonlight. storm: blended in by world.weatherIntensity. resolution: lighting canvas size as a fraction of the logical view; smooth: scale it up with smoothing.",
    "resolution": 0.5,
    "smooth": false,
    "ambient": [
      { "hour": 0, "color": "#101834", "$color": "deep_0", "darkness": 0.9 },
      { "hour": 4.6, "color": "#101834", "$color": "deep_0", "darkness": 0.9 },
      { "hour": 5.4, "color": "#1a284e", "$color": "deep_1", "darkness": 0.66 },
      { "hour": 6.2, "color": "#253d68", "$color": "deep_2", "darkness": 0.32 },
      { "hour": 7, "color": "#28767e", "$color": "teal_1", "darkness": 0.08 },
      { "hour": 7.6, "color": "#28767e", "$color": "teal_1", "darkness": 0 },
      { "hour": 17.4, "color": "#f2a33a", "$color": "amber", "darkness": 0 },
      { "hour": 18.2, "color": "#f2a33a", "$color": "amber", "darkness": 0.22 },
      { "hour": 19, "color": "#6b2c1e", "$color": "rust_0", "darkness": 0.45 },
      { "hour": 19.8, "color": "#1a284e", "$color": "deep_1", "darkness": 0.74 },
      { "hour": 20.6, "color": "#101834", "$color": "deep_0", "darkness": 0.9 }
    ],
    "moonLift": 0.6,
    "storm": { "color": "#37323f", "$color": "basalt_1", "darkness": 0.42, "colorMix": 0.85 },
    "player": { "radius": 48, "intensity": 0.8, "$comment": "the small awareness light that keeps the character visible at night" },
    "flashlight": { "length": 132, "width": 72, "offset": 56, "nearRadius": 26, "intensity": 0.95 },
    "glow": { "strength": 0.7, "dayFloor": 0.25 }
  },
  "weatherFx": {
    "$comment": "src/engine/WeatherFx.js (presentation): rain in screen space, counts at full squall intensity; speeds in logical px/s",
    "drops": 260,
    "dropLength": [5, 9],
    "fallSpeed": 420,
    "slant": 0.7,
    "splashes": 70,
    "splashSeconds": 0.24,
    "veil": 0.35,
    "colors": { "drop": "#cfeedd", "$drop": "foam", "dropDim": "#66c2b0", "$dropDim": "teal_3", "splash": "#e9e2cf", "$splash": "bone", "veil": "#37323f", "$veil": "basalt_1" },
    "swaySpeed": 1.7,
    "gustSpeed": 4.1
  },
  "water": {
    "$comment": "src/world/water.js depth classes from tide height h and a tile's flood threshold t: flooded (h > t) is shallow (wading) until h - t >= deepMargin, then deep (swimming); not flooded but t - h <= wetMargin is wet (about to flood or just drained). frameMs: water animation fallback when the sheet has no tag.",
    "wetMargin": 0.06,
    "deepMargin": 0.2,
    "frameMs": { "shallow_water": 400, "deep_water": 600 }
  },
  "terrain": {
    "sand": { "speed": 1 },
    "wet_sand": { "speed": 1 },
    "jungle_floor": { "speed": 0.9 },
    "basalt": { "speed": 1 },
    "reef_rock": { "speed": 0.95 },
    "mud": { "speed": 0.55, "mode": "wade" },
    "shallow_water": { "speed": 0.6, "mode": "wade" },
    "deep_water": { "speed": 0.45, "mode": "swim" },
    "swimSpeed": 0.45,
    "floodWadeSpeed": 0.6,
    "floodSwimDepth": 0.15,
    "modeExitMargin": 4,
    "lowTide": 0
  },
  "collision": {
    "subStepFraction": 0.5,
    "maxSubSteps": 64,
    "iterations": 6,
    "epsilon": 0.000001,
    "cornerAssist": { "maxOffset": 10, "probeStep": 1, "lookAhead": 4, "minProgress": 0.25, "speed": 1 },
    "freeSearchStep": 2,
    "unstuckSearch": 320,
    "blocksSight": { "kayak": false, "dinghy": false, "totem": false, "tall_grass": false }
  },
  "stuck": {
    "seconds": 3,
    "epsilon": 2
  },
  "camera": {
    "followRate": 6,
    "shakeDecay": 6,
    "maxShake": 8
  },
  "input": {
    "joystick": { "deadZone": 8, "walkRadius": 40, "ringRadius": 60, "sprintEnter": 54, "sprintExit": 46, "knobRadius": 18 },
    "buttons": { "size": 60, "primarySize": 76, "gap": 10, "margin": 14, "barSize": 58, "barGap": 8, "arcStepDeg": 45 },
    "maxSizeFraction": 0.3,
    "dragThreshold": 14,
    "throwAimDistance": 120,
    "opacity": { "idle": 0.38, "pressed": 0.75, "active": 0.65, "disabled": 0.2, "joystick": 0.45, "hint": 0.2 }
  },
  "testField": {
    "halfWidth": 400,
    "halfHeight": 300,
    "clearRadius": 40,
    "minSpacing": 28,
    "placementTries": 30,
    "counts": { "palm": 16, "rock": 12, "tall_grass": 22, "monolith": 1 }
  }
}
